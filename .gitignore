# =============================================================================
#  cell.cpp — ignore rules
#
#  Layers:  core runtime = cell.cpp · include/ · cmake/ · docs/ · tests/
#           webui layer  = webui/ (cellui.cpp · frontend/ · vendored webui)
#  Ignored:             every build output, package manager cache and local tool
#                       scratch space.
# =============================================================================

# ---- build outputs (CMake, bare g++, bare clang++) ---------------------------
build/
out/
cmake-build-*/
CMakeUserPresets.json
CMakeCache.txt
CMakeFiles/
compile_commands.json
.cache/
*.o
*.obj
*.a
*.lib
*.so
*.so.*
*.dylib
*.dll
*.exe
*.pdb
*.ilk
*.idb
*.exp
*.iobj
*.ipdb
*.gcno
*.gcda
*.gcov

# ---- install / packaging -----------------------------------------------------
install/
dist-staging/
cell-config.cmake
cell-config-version.cmake
cell-config*.cmake

# ---- local editor / IDE scratch ---------------------------------------------
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db

# ---- front-end (bun / vite) --------------------------------------------------
node_modules/
webui/frontend/node_modules/
webui/frontend/dist/
webui/frontend/.vite/
webui/frontend/.tanstack/
bun.lockb.bak
*.tsbuildinfo
*.tsbuildinfo.*
.eslintcache
.stylelintcache

# ---- project-local runtime state --------------------------------------------
# .cell/ is created by the agent at runtime (sessions, tokens, server.json)
.cell/
*.cell-session
logs/
*.log

# ---- local scratch / ad-hoc dirs ---------------------------------------------
etc/
bin/
tmp/
tools-local/
*.local

# ---- large one-off analysis artefacts (not part of the design docs) ----------
agent-gui-api-assessment.html
.cell-selftest/

.workbuddy/
