#define CELL_VERSION_MAJOR @PROJECT_VERSION_MAJOR@
#define CELL_VERSION_MINOR @PROJECT_VERSION_MINOR@
#define CELL_VERSION_PATCH @PROJECT_VERSION_PATCH@
#define CELL_VERSION_STR "@PROJECT_VERSION@"

// Application icon — the brand mark (assets/brand/cell.ico). CMake substitutes
// the absolute path at configure time so the resource compiler finds it.
IDI_ICON1 ICON DISCARDABLE "@CELL_BRAND_DIR@/cell.ico"

// Version resource shown in Explorer / file properties.
VS_VERSION_INFO VERSIONINFO
 FILEVERSION CELL_VERSION_MAJOR,CELL_VERSION_MINOR,CELL_VERSION_PATCH,0
 PRODUCTVERSION CELL_VERSION_MAJOR,CELL_VERSION_MINOR,CELL_VERSION_PATCH,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "cell.cpp"
            VALUE "FileDescription", "cell - single-file AI coding agent"
            VALUE "FileVersion", CELL_VERSION_STR
            VALUE "InternalName", "cell"
            VALUE "LegalCopyright", "MIT License"
            VALUE "OriginalFilename", "cell.exe"
            VALUE "ProductName", "cell"
            VALUE "ProductVersion", CELL_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
